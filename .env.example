# Credenciales de la cuenta de servicio de Google (server-side, usadas en
# api/tarima-form.js para escribir en el Google Sheet). Sacalas del mismo
# JSON de cuenta de servicio que ya usa dashboard_col.py / el Streamlit app.
GOOGLE_CLIENT_EMAIL=
# Pegar la private_key completa, con los \n literales tal cual vienen en el JSON
# (no hace falta convertirlos a saltos de línea reales, el código ya lo hace).
GOOGLE_PRIVATE_KEY=
